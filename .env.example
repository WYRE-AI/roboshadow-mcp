# RoboShadow Refresh Token. Generate at your RoboShadow portal -> Reports ->
# API Token, which shows an Organisation ID, a short-lived Bearer Token, and
# this Refresh Token. This connector stores the Refresh Token (it does not
# expire on the ~1hr cadence the Bearer Token does) and exchanges it for a
# fresh Bearer Token internally before each API call via POST
# /identity/bearertoken.
#
# Used by stdio and by HTTP only when AUTH_MODE=env. The gateway-mode compose
# service does not load this. Do not add it to that service's environment or
# via env_file.
ROBOSHADOW_REFRESH_TOKEN=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# env (default; stdio and single-tenant HTTP) or gateway. Gateway mode requires
# X-RoboShadow-Refresh-Token on each /mcp request and never falls back to
# ROBOSHADOW_REFRESH_TOKEN. The container image and Compose default to gateway.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty. The process logs an
# error and exits non-zero when it is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). Compose will not start when it is unset.
# Never commit a real value. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The process logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A wider MCP_HTTP_HOST (including 0.0.0.0) is
# ignored in that mode. A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address. Honored when CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1
# when unset. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# LOG_LEVEL=info
